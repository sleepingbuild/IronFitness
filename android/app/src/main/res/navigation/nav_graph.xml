<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <action
        android:id="@+id/action_global_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.homefit.app.ui.auth.SplashFragment"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_workout"
            app:destination="@id/workoutFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.homefit.app.ui.auth.LoginFragment"
        android:label="@string/login_title"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_workout"
            app:destination="@id/workoutFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.homefit.app.ui.auth.RegisterFragment"
        android:label="@string/register_title"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_workout"
            app:destination="@id/workoutFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Tab Tập luyện -->
    <fragment
        android:id="@+id/workoutFragment"
        android:name="com.homefit.app.ui.library.CategoryFragment"
        android:label="@string/nav_workout"
        tools:layout="@layout/fragment_category">
        <action
            android:id="@+id/action_category_to_exerciseList"
            app:destination="@id/exerciseListFragment" />
    </fragment>

    <fragment
        android:id="@+id/exerciseListFragment"
        android:name="com.homefit.app.ui.library.ExerciseListFragment"
        android:label="@string/nav_exercise_list"
        tools:layout="@layout/fragment_exercise_list">
        <argument
            android:name="categoryId"
            app:argType="long" />
        <argument
            android:name="categoryName"
            app:argType="string" />
        <action
            android:id="@+id/action_exerciseList_to_detail"
            app:destination="@id/exerciseDetailFragment" />
        <action
            android:id="@+id/action_exerciseList_to_player"
            app:destination="@id/playerFragment" />
    </fragment>

    <fragment
        android:id="@+id/exerciseDetailFragment"
        android:name="com.homefit.app.ui.library.ExerciseDetailFragment"
        android:label="@string/nav_exercise_detail"
        tools:layout="@layout/fragment_exercise_detail">
        <argument
            android:name="categoryId"
            app:argType="long" />
        <argument
            android:name="exerciseId"
            app:argType="long" />
        <action
            android:id="@+id/action_detail_to_player"
            app:destination="@id/playerFragment" />
    </fragment>

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.homefit.app.ui.player.WorkoutPlayerFragment"
        android:label="@string/nav_player"
        tools:layout="@layout/fragment_player">
        <argument
            android:name="categoryId"
            app:argType="long" />
        <action
            android:id="@+id/action_player_to_summary"
            app:destination="@id/workoutSummaryFragment"
            app:popUpTo="@id/playerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/workoutSummaryFragment"
        android:name="com.homefit.app.ui.player.WorkoutSummaryFragment"
        android:label="@string/nav_player"
        tools:layout="@layout/fragment_workout_summary" />

    <!-- Tab Lịch sử & Thống kê -->
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.homefit.app.ui.history.HistoryFragment"
        android:label="@string/nav_history"
        tools:layout="@layout/fragment_history" />

    <!-- Tab Hồ sơ -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.homefit.app.ui.profile.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile" />

    <!-- Tab Cài đặt -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.homefit.app.ui.settings.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings" />
</navigation>