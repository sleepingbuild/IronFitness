<?xml version="1.0" encoding="utf-8"?>
<!--
  Khối trạng thái dùng chung (rỗng hoặc lỗi). Màn hình nhúng bằng <include android:id="@+id/stateView">,
  rồi đặt chữ và nút theo từng trạng thái.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_xl">

    <ImageView
        android:id="@+id/ivStateIcon"
        android:layout_width="@dimen/icon_large"
        android:layout_height="@dimen/icon_large"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_state_info"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/tvStateMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.HomeFit.Body"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStateAction"
        style="@style/Widget.HomeFit.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/action_retry" />
</LinearLayout>
