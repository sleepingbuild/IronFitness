<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dayRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/touch_min"
    android:padding="2dp">

    <LinearLayout
        android:id="@+id/dayCellContainer"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDayNumber"
            style="@style/TextAppearance.HomeFit.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            tools:text="15" />

        <View
            android:id="@+id/viewWorkoutDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_calendar_workout_dot"
            android:visibility="invisible"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>