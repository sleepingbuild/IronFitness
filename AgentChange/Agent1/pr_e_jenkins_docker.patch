+                            }
+                            Start-Sleep -Seconds 5
+                        }
+                        if (-not $ok) { throw "Docker web that bai: $url khong tra ve 200" }
+                        Write-Host "Docker OK: $url tra ve 200"
+                    }
+
+                    docker image prune -f | Out-Null
