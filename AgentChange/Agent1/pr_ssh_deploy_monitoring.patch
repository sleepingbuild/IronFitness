diff --git a/scripts/deploy/remote-deploy.ps1 b/scripts/deploy/remote-deploy.ps1
new file mode 100644
index 0000000..32ffda2
--- /dev/null
+++ b/scripts/deploy/remote-deploy.ps1
@@ -0,0 +1,105 @@
+# remote-deploy.ps1 - CHAY TREN MAY CHU WINDOWS (Jenkins goi qua SSH, xem Jenkinsfile stage "Deploy SSH" khi GMS_SSH_OS=windows).
+# Giong remote-deploy.sh: lay dung commit vua xanh, dung lai backend + frontend + Prometheus + Grafana bang Docker Compose,
+# cho den khi tat ca tra loi. Giu nguyen SQL Server, Redis va du lieu.
+# Bi mat (mat khau DB, JWT, Grafana) dat trong %USERPROFILE%\.gms.env, KHONG dat trong repo. Xem docs/CICD_SSH_DEPLOY.md.
+param(
+    [Parameter(Mandatory = $true)][string]$RepoUrl,
+    [string]$Commit = "",
+    [string]$Branch = "master",
+    [string]$AppDir = (Join-Path $env:USERPROFILE "gms-server"),
+    [string]$PublicHost = "localhost"
+)
+
+# Lenh native (docker, git) ghi stderr nhieu, nen dung Continue va tu kiem tra $LASTEXITCODE.
+$ErrorActionPreference = "Continue"
+
+function Log($m) { Write-Host "[deploy] $m" }
+function Fail($m) { Write-Host "[deploy][LOI] $m"; exit 1 }
+
+$apiPort = if ($env:GMS_API_PORT) { $env:GMS_API_PORT } else { "8082" }
+$webPort = if ($env:GMS_WEB_PORT) { $env:GMS_WEB_PORT } else { "3000" }
+$promPort = if ($env:GMS_PROMETHEUS_PORT) { $env:GMS_PROMETHEUS_PORT } else { "9090" }
+$grafanaPort = if ($env:GMS_GRAFANA_PORT) { $env:GMS_GRAFANA_PORT } else { "3001" }
+
+foreach ($cmd in @("git", "docker")) {
+    if (-not (Get-Command $cmd -ErrorAction SilentlyContinue)) { Fail "Chua co lenh $cmd trong PATH cua phien SSH" }
+}
+docker info *> $null
+if ($LASTEXITCODE -ne 0) { Fail "Khong dung duoc Docker: mo Docker Desktop va dam bao tai khoan $env:USERNAME thuoc nhom docker-users" }
+
+# 1. Lay ma nguon
+if (-not (Test-Path (Join-Path $AppDir ".git"))) {
+    Log "Clone lan dau vao $AppDir"
+    git clone $RepoUrl $AppDir
+    if ($LASTEXITCODE -ne 0) { Fail "git clone that bai" }
+}
+Set-Location $AppDir
+git remote set-url origin $RepoUrl
+git fetch --prune origin $Branch
+if ($LASTEXITCODE -ne 0) { Fail "git fetch that bai" }
+$target = if ($Commit) { $Commit } else { "origin/$Branch" }
+git checkout --force --detach $target
+if ($LASTEXITCODE -ne 0) { Fail "Khong checkout duoc $target (commit chua co tren nhanh $Branch?)" }
+Log ("Ma nguon: " + (git rev-parse --short HEAD) + " " + (git log -1 --format=%s))
+
+# Bi mat cua may chu nam ngoai repo
+$envFile = Join-Path $env:USERPROFILE ".gms.env"
+if (Test-Path $envFile) {
+    Copy-Item $envFile (Join-Path $AppDir ".env") -Force
+    Log "Dung bi mat tu $envFile"
+} else {
+    Log "CANH BAO: chua co $envFile nen dang dung mat khau/JWT mac dinh cua ban demo (xem docs/CICD_SSH_DEPLOY.md)"
+}
+
+# 2. Trinh duyet goi API theo dia chi cong khai cua may chu (nhung vao ma web luc build)
+$env:GMS_PUBLIC_API_URL = "http://${PublicHost}:${apiPort}"
+$compose = @("compose", "-f", "docker-compose.demo.yml", "-f", "docker-compose.monitoring.yml")
+
+# 3. Dung lai he thong
+$existing = docker @compose ps -aq sqlserver 2>$null
+if (-not $existing) {
+    Log "Lan dau: dung toan bo he thong (SQL Server, Redis, backend, nap du lieu mau, frontend, giam sat). Mat 5 den 10 phut."
+    docker @compose up -d --build
+} else {
+    Log "Cap nhat backend, frontend, Prometheus, Grafana (giu nguyen SQL Server, Redis, du lieu)"
+    docker @compose up -d --build backend frontend prometheus grafana
+}
+if ($LASTEXITCODE -ne 0) {
+    Log "Neu loi co chu: error getting credentials / logon session: xoa dong credsStore trong %USERPROFILE%\.docker\config.json roi chay lai (docs/CICD_SSH_DEPLOY.md)"
+    Fail "docker compose up that bai"
+}
+docker @compose kill -s SIGHUP prometheus *> $null
+
+# 4. Cho tat ca san sang
+function Wait-For($name, $url, $tries) {
+    for ($i = 1; $i -le $tries; $i++) {
+        try {
+            $r = Invoke-WebRequest -Uri $url -UseBasicParsing -TimeoutSec 10
+            if ($r.StatusCode -eq 200) { Log "OK  $name  $url"; return }
+        } catch { }
+        Start-Sleep -Seconds 5
+    }
+    docker @compose ps
+    docker @compose logs --tail=60 backend
+    Fail "$name khong san sang: $url"
+}
+Wait-For "API (backend)" "http://localhost:$apiPort/actuator/health" 72
+Wait-For "Web (frontend)" "http://localhost:$webPort/" 36
+Wait-For "Prometheus" "http://localhost:$promPort/-/ready" 24
+Wait-For "Grafana" "http://localhost:$grafanaPort/api/health" 24
+
+$scraping = $false
+for ($i = 1; $i -le 12; $i++) {
+    try {
+        $q = [uri]::EscapeDataString('max(up{job="gms-backend"})')
+        $r = Invoke-WebRequest -Uri "http://localhost:$promPort/api/v1/query?query=$q" -UseBasicParsing -TimeoutSec 10
+        if ($r.Content -match ',"1"\]') { $scraping = $true; break }
+    } catch { }
+    Start-Sleep -Seconds 5
+}
+if ($scraping) { Log "OK  Prometheus dang thu thap so lieu cua gms-backend" }
+else { Log "CANH BAO: chua thay gms-backend o trang thai up (xem http://${PublicHost}:${promPort}/targets)" }
+
+docker image prune -f *> $null
+Log "XONG. Web http://${PublicHost}:${webPort}  API http://${PublicHost}:${apiPort}/swagger-ui.html  Grafana http://${PublicHost}:${grafanaPort}"
+exit 0
diff --git a/scripts/deploy/remote-deploy.sh b/scripts/deploy/remote-deploy.sh
new file mode 100755
index 0000000..1f1434c
--- /dev/null
+++ b/scripts/deploy/remote-deploy.sh
@@ -0,0 +1,100 @@
+#!/usr/bin/env bash
+# remote-deploy.sh - CHAY TREN MAY CHU (Jenkins goi qua SSH, xem Jenkinsfile stage "Deploy SSH").
+# Lay ma nguon dung commit vua xanh, dung lai backend + frontend + Prometheus + Grafana bang Docker Compose,
+# roi cho den khi tat ca tra loi. Giu nguyen SQL Server, Redis va du lieu.
+#
+# Bien moi truong (Jenkins truyen vao):
+#   GMS_REPO_URL      (bat buoc) dia chi git cua repo
+#   GMS_COMMIT        commit can trien khai (mac dinh: dau nhanh GMS_BRANCH)
+#   GMS_BRANCH        nhanh (mac dinh master)
+#   GMS_PUBLIC_HOST   dia chi trinh duyet dung de goi API (IP hoac ten may chu), mac dinh localhost
+#   GMS_APP_DIR       thu muc dat ma nguon tren may chu (mac dinh $HOME/gms)
+# Bi mat (mat khau DB, JWT, Grafana) dat trong ~/.gms.env tren may chu, KHONG dat trong repo. Xem docs/CICD_SSH_DEPLOY.md.
+set -euo pipefail
+
+REPO_URL="${GMS_REPO_URL:?Thieu GMS_REPO_URL}"
+BRANCH="${GMS_BRANCH:-master}"
+COMMIT="${GMS_COMMIT:-}"
+APP_DIR="${GMS_APP_DIR:-$HOME/gms}"
+PUBLIC_HOST="${GMS_PUBLIC_HOST:-localhost}"
+API_PORT="${GMS_API_PORT:-8082}"
+WEB_PORT="${GMS_WEB_PORT:-3000}"
+PROM_PORT="${GMS_PROMETHEUS_PORT:-9090}"
+GRAFANA_PORT="${GMS_GRAFANA_PORT:-3001}"
+
+log() { echo "[deploy] $*"; }
+die() { echo "[deploy][LOI] $*" >&2; exit 1; }
+
+for cmd in git docker curl; do
+  command -v "$cmd" >/dev/null 2>&1 || die "Chua cai $cmd tren may chu (chay scripts/deploy/setup-server.sh)"
+done
+docker info >/dev/null 2>&1 || die "Tai khoan $(whoami) khong dung duoc Docker. Them vao nhom docker roi dang nhap lai: sudo usermod -aG docker $(whoami)"
+
+# 1. Lay ma nguon
+if [ ! -d "$APP_DIR/.git" ]; then
+  log "Clone lan dau vao $APP_DIR"
+  git clone "$REPO_URL" "$APP_DIR"
+fi
+cd "$APP_DIR"
+git remote set-url origin "$REPO_URL"
+git fetch --prune origin "$BRANCH"
+TARGET="${COMMIT:-origin/$BRANCH}"
+git checkout --force --detach "$TARGET" || die "Khong checkout duoc $TARGET (commit chua co tren nhanh $BRANCH?)"
+log "Ma nguon: $(git rev-parse --short HEAD) $(git log -1 --format=%s)"
+
+# Bi mat cua may chu (mat khau DB, JWT, Grafana) nam ngoai repo, o ~/.gms.env; Docker Compose doc qua tep .env
+if [ -f "$HOME/.gms.env" ]; then
+  cp "$HOME/.gms.env" "$APP_DIR/.env"
+  chmod 600 "$APP_DIR/.env"
+  log "Dung bi mat tu ~/.gms.env"
+else
+  log "CANH BAO: chua co ~/.gms.env nen dang dung mat khau/JWT mac dinh cua ban demo (xem docs/CICD_SSH_DEPLOY.md)"
+fi
+
+# 2. Cau hinh cho may chu: trinh duyet goi API theo dia chi cong khai cua may chu (nhung vao ma web luc build)
+export GMS_PUBLIC_API_URL="http://${PUBLIC_HOST}:${API_PORT}"
+export GMS_API_PORT GMS_WEB_PORT GMS_PROMETHEUS_PORT GMS_GRAFANA_PORT
+COMPOSE=(docker compose -f docker-compose.demo.yml -f docker-compose.monitoring.yml)
+
+# 3. Dung lai he thong
+if [ -z "$("${COMPOSE[@]}" ps -aq sqlserver 2>/dev/null)" ]; then
+  log "Lan dau: dung toan bo he thong (SQL Server, Redis, backend, nap du lieu mau, frontend, giam sat). Mat 5 den 10 phut."
+  "${COMPOSE[@]}" up -d --build
+else
+  log "Cap nhat backend, frontend, Prometheus, Grafana (giu nguyen SQL Server, Redis, du lieu)"
+  "${COMPOSE[@]}" up -d --build backend frontend prometheus grafana
+fi
+# Prometheus doc lai cau hinh va luat canh bao khi cac tep nay doi (tep mount, container khong tu tao lai)
+"${COMPOSE[@]}" kill -s SIGHUP prometheus >/dev/null 2>&1 || true
+
+# 4. Cho tat ca san sang
+wait_for() { # ten url so_lan
+  local name="$1" url="$2" tries="${3:-60}" i
+  for ((i = 1; i <= tries; i++)); do
+    if curl -fsS -o /dev/null --max-time 10 "$url"; then log "OK  $name  $url"; return 0; fi
+    sleep 5
+  done
+  echo "[deploy][LOI] $name khong san sang: $url" >&2
+  "${COMPOSE[@]}" ps >&2 || true
+  "${COMPOSE[@]}" logs --tail=60 backend >&2 || true
+  return 1
+}
+wait_for "API (backend)" "http://localhost:${API_PORT}/actuator/health" 72
+wait_for "Web (frontend)" "http://localhost:${WEB_PORT}/" 36
+wait_for "Prometheus" "http://localhost:${PROM_PORT}/-/ready" 24
+wait_for "Grafana" "http://localhost:${GRAFANA_PORT}/api/health" 24
+
+# Prometheus phai lay duoc so lieu cua backend (can vai chuc giay sau khi backend len)
+for ((i = 1; i <= 12; i++)); do
+  if curl -fsSG --max-time 10 --data-urlencode 'query=max(up{job="gms-backend"})' \
+       "http://localhost:${PROM_PORT}/api/v1/query" | grep -q ',"1"\]'; then
+    log "OK  Prometheus dang thu thap so lieu cua gms-backend"; break
+  fi
+  if [ "$i" -eq 12 ]; then
+    log "CANH BAO: chua thay gms-backend o trang thai up (xem http://${PUBLIC_HOST}:${PROM_PORT}/targets)"
+  fi
+  sleep 5
+done
+
+docker image prune -f >/dev/null 2>&1 || true
+log "XONG. Web http://${PUBLIC_HOST}:${WEB_PORT}  API http://${PUBLIC_HOST}:${API_PORT}/swagger-ui.html  Grafana http://${PUBLIC_HOST}:${GRAFANA_PORT}"
diff --git a/scripts/deploy/setup-server.sh b/scripts/deploy/setup-server.sh
new file mode 100755
index 0000000..6d12833
--- /dev/null
+++ b/scripts/deploy/setup-server.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+# setup-server.sh - Chuan bi may chu Ubuntu/Debian MOT LAN de Jenkins deploy qua SSH. Chay tren may chu:
+#   bash setup-server.sh
+# Can sudo va Internet. Cai Docker, git, curl, SSH server; them tai khoan hien tai vao nhom docker; mo cong.
+set -euo pipefail
+
+[ "$(id -u)" -eq 0 ] && { echo "Hay chay bang tai khoan thuong co sudo, khong chay bang root."; exit 1; }
+
+echo "== Cai goi can thiet"
+sudo apt-get update -y
+sudo apt-get install -y git curl ca-certificates openssh-server
+
+if ! command -v docker >/dev/null 2>&1; then
+  echo "== Cai Docker Engine (get.docker.com)"
+  curl -fsSL https://get.docker.com | sudo sh
+fi
+sudo systemctl enable --now docker ssh 2>/dev/null || sudo systemctl enable --now docker sshd
+
+echo "== Cho phep $(whoami) dung Docker khong can sudo"
+sudo usermod -aG docker "$(whoami)"
+
+if command -v ufw >/dev/null 2>&1 && sudo ufw status | grep -q "Status: active"; then
+  echo "== Mo cong tuong lua (ufw)"
+  for p in 22 3000 8082 3001 9090; do sudo ufw allow "$p/tcp"; done
+fi
+
+echo
+echo "XONG. Dang xuat roi dang nhap lai de nhom docker co hieu luc, kiem tra: docker run --rm hello-world"
+echo "Dia chi IP cua may chu: $(hostname -I | awk '{print $1}')"
